#BASHTHEME PERSONALIZED FOR HYPRLAND RICE
# theme: Matugen Neon Glass (Full Background Deduction)

# --- COLORES GLOBALES ---
# Fondo: Tu color base (Surface).
theme[main_bg]="{{colors.surface.default.hex}}"

# Texto principal: Tu color de texto (On Surface).
theme[main_fg]="{{colors.on_surface.default.hex}}"

# Títulos de las cajas: Texto negrita (On Surface Bold).
theme[title]="{{colors.on_surface.default.hex}}"

# Teclas de atajo (Highlights): Tu color Primario Neón.
theme[hi_fg]="{{colors.primary_fixed.default.hex}}"

# Selección: Fondo neón Secundario, texto oscuro para contraste.
theme[selected_bg]="{{colors.secondary_fixed.default.hex}}"
theme[selected_fg]="{{colors.on_secondary_fixed.default.hex}}"

# --- ELIMINACIÓN DEL GRIS (Vital) ---
# Inactive FG: Es el color de las líneas y marcos "apagados". 
# Usamos 'surface_container_high' para que parezca cristal, no gris cemento.
theme[inactive_fg]="{{colors.surface_container_high.default.hex}}"

# Graph Text: El texto pequeño dentro de las gráficas.
theme[graph_text]="{{colors.primary_fixed_dim.default.hex}}"

# Meter BG: El fondo "vacío" de las barras de progreso. Oscuro pero con tinte.
theme[meter_bg]="{{colors.surface_container_highest.default.hex}}"

# Proc Misc: Líneas de conexión del árbol de procesos.
theme[proc_misc]="{{colors.outline.default.hex}}"

# --- COLORES DE LAS CAJAS (BORDES) ---
# Cada caja tiene su propia identidad de color neón.
theme[cpu_box]="{{colors.primary_fixed.default.hex}}"      # Azul/Primario
theme[mem_box]="{{colors.secondary_fixed.default.hex}}"    # Verde/Secundario
theme[net_box]="{{colors.tertiary_fixed.default.hex}}"     # Rosa/Naranja/Terciario
theme[proc_box]="{{colors.primary.default.hex}}"           # Azul sólido

# Líneas divisorias
theme[div_line]="{{colors.surface_container_highest.default.hex}}"

# --- GRADIENTES DE TEMPERATURA (Adiós Verde->Rojo) ---
# De "frío" (Secondary) a "caliente" (Tertiary/Acento)
theme[temp_start]="{{colors.secondary_fixed.default.hex}}"
theme[temp_mid]="{{colors.secondary.default.hex}}"
theme[temp_end]="{{colors.tertiary_fixed.default.hex}}"

# --- GRADIENTES DE CPU (Neón Azulado) ---
theme[cpu_start]="{{colors.primary_fixed.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.on_primary_container.default.hex}}"

# --- GRADIENTES DE MEMORIA (Libre - Neón Verdoso/Secundario) ---
theme[free_start]="{{colors.secondary_fixed.default.hex}}"
theme[free_mid]="{{colors.secondary.default.hex}}"
theme[free_end]="{{colors.on_secondary_container.default.hex}}"

# --- GRADIENTES DE MEMORIA (Caché - Tono intermedio/Teal) ---
theme[cached_start]="{{colors.secondary_fixed_dim.default.hex}}"
theme[cached_mid]="{{colors.secondary_container.default.hex}}"
theme[cached_end]="{{colors.on_secondary_container.default.hex}}"

# --- GRADIENTES DE MEMORIA (Disponible - Similar a Free) ---
theme[available_start]="{{colors.secondary_fixed.default.hex}}"
theme[available_mid]="{{colors.secondary.default.hex}}"
theme[available_end]="{{colors.on_secondary_container.default.hex}}"

# --- GRADIENTES DE MEMORIA (Usada - Alerta/Terciario Suave) ---
theme[used_start]="{{colors.tertiary_fixed.default.hex}}"
theme[used_mid]="{{colors.tertiary.default.hex}}"
theme[used_end]="{{colors.on_tertiary_container.default.hex}}"

# --- GRADIENTES DE RED (Descarga - Primario) ---
theme[download_start]="{{colors.primary_fixed.default.hex}}"
theme[download_mid]="{{colors.primary.default.hex}}"
theme[download_end]="{{colors.on_primary_container.default.hex}}"

# --- GRADIENTES DE RED (Subida - Secundario/Acento) ---
theme[upload_start]="{{colors.secondary_fixed.default.hex}}"
theme[upload_mid]="{{colors.secondary.default.hex}}"
theme[upload_end]="{{colors.on_secondary_container.default.hex}}"

# --- GRÁFICA DE PROCESOS (Gradiente complejo) ---
theme[process_start]="{{colors.primary_fixed.default.hex}}"
theme[process_mid]="{{colors.secondary_fixed.default.hex}}"
theme[process_end]="{{colors.tertiary_fixed.default.hex}}"

      },
      {
        "name": "Markdown Blockquotes",
        "scope": ["markup.quote"],
        "settings": {
          "foreground": "{{colors.outline.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Regular expressions",
        "scope": ["string.regexp"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}"
        }
      },
      {
        "name": "Regex groups",
        "scope": ["punctuation.definition.group.regexp"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "Python decorators",
        "scope": ["entity.name.function.decorator.python"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Python magic methods (dunder)",
        "scope": ["support.function.magic.python"],
        "settings": {
          "foreground": "{{colors.on_primary_container.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust lifetimes",
        "scope": ["storage.modifier.lifetime.rust", "entity.name.lifetime.rust"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust macros",
        "scope": ["entity.name.function.macro.rust", "support.macro.rust"],
        "settings": {
          "foreground": "{{colors.on_secondary_container.dark.hex}}"
        }
      },
      {
        "name": "Punctuation",
        "scope": ["punctuation.definition", "punctuation.separator", "punctuation.terminator"],
        "settings": {
          "foreground": "{{colors.on_surface_variant.dark.hex}}"
        }
      },
      {
        "name": "Invalid",
        "scope": ["invalid", "invalid.illegal"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}",
          "fontStyle": "underline"
        }
      }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "namespace":              { "foreground": "{{colors.secondary.dark.hex}}" },
      "class":                  { "foreground": "{{colors.secondary.dark.hex}}" },
      "class.declaration":      { "foreground": "{{colors.secondary.dark.hex}}", "fontStyle": "bold" },
      "interface":              { "foreground": "{{colors.on_tertiary_container.dark.hex}}" },
      "enum":                   { "foreground": "{{colors.secondary.dark.hex}}" },
      "enumMember":             { "foreground": "{{colors.on_tertiary_container.dark.hex}}" },
      "typeParameter":          { "foreground": "{{colors.on_tertiary_container.dark.hex}}", "fontStyle": "italic" },
      "function":               { "foreground": "{{colors.on_primary_container.dark.hex}}" },
      "function.declaration":   { "foreground": "{{colors.on_primary_container.dark.hex}}", "fontStyle": "bold" },
      "method":                 { "foreground": "{{colors.on_primary_container.dark.hex}}" },
      "method.declaration":     { "foreground": "{{colors.on_primary_container.dark.hex}}", "fontStyle": "bold" },
      "property":               { "foreground": "{{colors.on_secondary_container.dark.hex}}" },
      "property.readonly":      { "foreground": "{{colors.on_secondary_container.dark.hex}}", "fontStyle": "italic" },
      "property.declaration":   { "foreground": "{{colors.on_secondary_container.dark.hex}}" },
      "variable":               { "foreground": "{{colors.on_surface.dark.hex}}" },
      "variable.readonly":      { "foreground": "{{colors.on_surface.dark.hex}}", "fontStyle": "italic" },
      "variable.declaration":   { "foreground": "{{colors.on_surface.dark.hex}}" },
      "parameter":              { "foreground": "{{colors.on_primary_container.dark.hex}}", "fontStyle": "italic" },
      "type":                   { "foreground": "{{colors.on_tertiary_container.dark.hex}}" },
      "macro":                  { "foreground": "{{colors.on_secondary_container.dark.hex}}" },
      "decorator":              { "foreground": "{{colors.secondary.dark.hex}}", "fontStyle": "italic" },
      "event":                  { "foreground": "{{colors.error.dark.hex}}" },
      "keyword":                { "foreground": "{{colors.primary.dark.hex}}", "fontStyle": "italic" },
      "comment":                { "foreground": "{{colors.outline.dark.hex}}", "fontStyle": "italic" },
      "string":                 { "foreground": "{{colors.tertiary.dark.hex}}" },
      "number":                 { "foreground": "{{colors.error.dark.hex}}" },
      "operator":               { "foreground": "{{colors.on_secondary_container.dark.hex}}" },
      "selfParameter":          { "foreground": "{{colors.primary.dark.hex}}", "fontStyle": "italic" },
      "magicFunction":          { "foreground": "{{colors.on_primary_container.dark.hex}}", "fontStyle": "italic" },
      "label":                  { "foreground": "{{colors.on_surface_variant.dark.hex}}" }
    }
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderLineHighlight": "gutter",
  "window.dialogStyle": "custom",
  "workbench.tree.indent": 14,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "workbench.tree.renderIndentGuides": "always",
  "material-code.css": "body { --radius: 0px; }"
}

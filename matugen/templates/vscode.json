  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comments",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "{{colors.outline.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "JSDoc / Docstrings",
        "scope": ["comment.block.documentation"],
        "settings": {
          "foreground": "{{colors.outline.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "JSDoc tags",
        "scope": ["storage.type.class.jsdoc"],
        "settings": {
          "foreground": "{{colors.on_surface_variant.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Keywords",
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Control flow (if / for / return)",
        "scope": [
          "keyword.control",
          "keyword.control.flow",
          "keyword.control.conditional",
          "keyword.control.loop",
          "keyword.control.return"
        ],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "bold italic"
        }
      },
      {
        "name": "Import / Export",
        "scope": [
          "keyword.control.import",
          "keyword.control.export",
          "keyword.control.from",
          "keyword.control.as"
        ],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Operators",
        "scope": ["keyword.operator"],
        "settings": {
          "foreground": "{{colors.on_secondary_container.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "Function names",
        "scope": [
          "entity.name.function",
          "support.function",
          "meta.function-call entity.name.function"
        ],
        "settings": {
          "foreground": "{{colors.on_primary_container.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "Function parameters",
        "scope": ["variable.parameter"],
        "settings": {
          "foreground": "{{colors.on_primary_container.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Strings",
        "scope": ["string", "string.quoted"],
        "settings": {
          "foreground": "{{colors.tertiary.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "Template literals",
        "scope": ["string.template"],
        "settings": {
          "foreground": "{{colors.tertiary.dark.hex}}"
        }
      },
      {
        "name": "Template expression punctuation",
        "scope": ["punctuation.definition.template-expression"],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}"
        }
      },
      {
        "name": "Escape sequences",
        "scope": ["constant.character.escape"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "Numbers",
        "scope": ["constant.numeric"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "Boolean / Null / Undefined",
        "scope": [
          "constant.language.boolean",
          "constant.language.null",
          "constant.language.undefined"
        ],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Built-in constants",
        "scope": ["constant.language", "support.constant"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}"
        }
      },
      {
        "name": "Variables",
        "scope": ["variable", "variable.other"],
        "settings": {
          "foreground": "{{colors.on_surface.dark.hex}}"
        }
      },
      {
        "name": "this / self / super",
        "scope": [
          "variable.language.this",
          "variable.language.self",
          "variable.language.super",
          "variable.language.special.self.python"
        ],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Classes & Types",
        "scope": [
          "entity.name.class",
          "entity.name.type",
          "support.class",
          "support.type"
        ],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "Interfaces (TypeScript)",
        "scope": ["entity.name.type.interface"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "Generics / Type parameters",
        "scope": ["entity.name.type.parameter", "meta.type.parameters"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Namespaces / Modules",
        "scope": ["entity.name.namespace", "entity.name.module"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}"
        }
      },
      {
        "name": "Enum members",
        "scope": ["variable.other.enummember"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "Object properties",
        "scope": [
          "variable.other.property",
          "support.variable.property",
          "meta.object-literal.key"
        ],
        "settings": {
          "foreground": "{{colors.on_secondary_container.dark.hex}}"
        }
      },
      {
        "name": "Decorators / Annotations",
        "scope": [
          "meta.decorator",
          "punctuation.decorator",
          "entity.name.function.decorator"
        ],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "HTML Tags",
        "scope": ["entity.name.tag"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}",
          "fontStyle": ""
        }
      },
      {
        "name": "HTML Attributes",
        "scope": ["entity.other.attribute-name"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "HTML Attribute values",
        "scope": [
          "string.quoted.double.html",
          "string.quoted.single.html"
        ],
        "settings": {
          "foreground": "{{colors.tertiary.dark.hex}}"
        }
      },
      {
        "name": "CSS Selectors",
        "scope": [
          "entity.name.tag.css",
          "entity.other.attribute-name.class.css",
          "entity.other.attribute-name.id.css"
        ],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}"
        }
      },
      {
        "name": "CSS Properties",
        "scope": ["support.type.property-name.css", "meta.property-name"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "CSS Values",
        "scope": ["meta.property-value", "support.constant.property-value"],
        "settings": {
          "foreground": "{{colors.tertiary.dark.hex}}"
        }
      },
      {
        "name": "CSS Units",
        "scope": ["keyword.other.unit"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}"
        }
      },
      {
        "name": "CSS Variables",
        "scope": ["variable.css", "variable.argument.css"],
        "settings": {
          "foreground": "{{colors.on_secondary_container.dark.hex}}"
        }
      },
      {
        "name": "CSS At-rules",
        "scope": ["keyword.control.at-rule"],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "JSON keys",
        "scope": ["source.json support.type.property-name"],
        "settings": {
          "foreground": "{{colors.on_primary_container.dark.hex}}"
        }
      },
      {
        "name": "YAML keys",
        "scope": ["entity.name.tag.yaml"],
        "settings": {
          "foreground": "{{colors.on_primary_container.dark.hex}}"
        }
      },
      {
        "name": "YAML anchors",
        "scope": ["entity.name.type.anchor.yaml"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}"
        }
      },
      {
        "name": "Markdown Headings",
        "scope": ["markup.heading"],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown Bold",
        "scope": ["markup.bold"],
        "settings": {
          "foreground": "{{colors.error.dark.hex}}",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Markdown Italic",
        "scope": ["markup.italic"],
        "settings": {
          "foreground": "{{colors.secondary.dark.hex}}",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Markdown Code",
        "scope": ["markup.inline.raw", "markup.fenced_code.block"],
        "settings": {
          "foreground": "{{colors.on_tertiary_container.dark.hex}}"
        }
      },
      {
        "name": "Markdown Links",
        "scope": ["markup.underline.link"],
        "settings": {
          "foreground": "{{colors.primary.dark.hex}}",
          "fontStyle": "underline"

/* --- FONDOS Y TEXTO BASE --- */
/* Usamos el 'background' más profundo para la terminal, para que contraste
   con los módulos de tu Waybar que usan 'surface-variant'. */
background            {{colors.background.default.hex}}
foreground            {{colors.on_surface.default.hex}}

/* --- SELECCIÓN DE TEXTO --- */
/* Para la selección, usamos el contenedor secundario (o primario). 
   Esto da ese efecto de "resaltador" suave típico de Material. */
selection_background  {{colors.secondary_container.default.hex}}
selection_foreground  {{colors.on_secondary_container.default.hex}}

/* --- CURSOR --- */
/* El cursor es tu punto de atención, así que usamos el PRIMARY fuerte,
   igual que el borde activo de tu Waybar. */
cursor                {{colors.primary.default.hex}}
cursor_text_color     {{colors.on_primary.default.hex}}

/* --- URLS --- */
url_color             {{colors.tertiary.default.hex}}

/* --- BORDES DE VENTANA (Si usas bordes internos de Kitty) --- */
active_border_color   {{colors.primary.default.hex}}
inactive_border_color {{colors.outline.default.hex}}
bell_border_color     {{colors.error.default.hex}}

/* --- BARRA DE PESTAÑAS (TAB BAR) --- */
/* Pestaña activa: Como un botón "filled" (Color solido) */
active_tab_foreground   {{colors.on_primary.default.hex}}
active_tab_background   {{colors.primary.default.hex}}
active_tab_font_style   bold

/* Pestaña inactiva: Como el fondo de tus módulos de Waybar (surface-variant) */
inactive_tab_foreground {{colors.on_surface_variant.default.hex}}
inactive_tab_background {{colors.surface_container.default.hex}}
inactive_tab_font_style normal

/* --- COLORES ANSI (SINTAXIS) --- */
/* AQUÍ ESTÁ EL TRUCO:
   Para que el código se vea bien, NO uses los colores "Container" (pasteles).
   Usamos las variantes "Fixed" o los colores base para garantizar vibrancia,
   tal como definiste en tu template de waybar. */

/* Negro / Gris oscuro */
color0  {{colors.surface_variant.default.hex}}
color8  {{colors.outline.default.hex}}

/* Rojo (Errores) */
color1  {{colors.error.default.hex}}
color9  {{colors.error_container.default.hex}}

/* Verde (Strings/Success) - Usamos Secondary Fixed para que destaque */
color2  {{colors.secondary_fixed.default.hex}}
color10 {{colors.secondary_fixed_dim.default.hex}}

/* Amarillo (Warning/Variables) - Usamos Tertiary Fixed */
color3  {{colors.tertiary_fixed.default.hex}}
color11 {{colors.tertiary_fixed_dim.default.hex}}

/* Azul (Functions/Keywords) - El color Primario */
color4  {{colors.primary.default.hex}}
color12 {{colors.primary_fixed.default.hex}}

/* Magenta (Constantes) - Usamos Secondary */
color5  {{colors.secondary.default.hex}}
color13 {{colors.secondary_container.default.hex}}

/* Cyan (Operadores/Special) - Usamos Tertiary */
color6  {{colors.tertiary.default.hex}}
color14 {{colors.tertiary_container.default.hex}}

/* Blanco / Texto brillante */
color7  {{colors.on_surface.default.hex}}
color15 {{colors.inverse_surface.default.hex}}

# --- Fondo y Transparencia ---
# Usamos 'surface' para mantener la coherencia con el wallpaper
# pero la transparencia hará el trabajo de mezcla.
background #{{colors.surface.default.hex_stripped}}

# --- Primer Plano (Texto) ---
# Usamos 'on_surface_variant' en lugar de 'on_surface' puro
# para evitar un contraste negro agresivo. Es un gris oscuro/suave.
foreground #{{colors.on_surface_variant.default.hex_stripped}}

# --- Cursor ---
# El cursor usa el color primario para destacar sin romper la armonía.
cursor #{{colors.primary.default.hex_stripped}}
cursor_text_color #{{colors.on_primary.default.hex_stripped}}

# --- Selección ---
selection_foreground #{{colors.on_secondary.default.hex_stripped}}
selection_background #{{colors.secondary.default.hex_stripped}}

# --- Bordes ---
active_border_color #{{colors.primary.default.hex_stripped}}
inactive_border_color #{{colors.outline_variant.default.hex_stripped}}

# --- Paleta de 16 Colores (Variaciones de sí mismo) ---
# En lugar de buscar colores ajenos, reciclamos la paleta generada
# (Primary, Secondary, Tertiary, Error) para mantener consistencia total.

# Negro (No usamos negro puro, sino una variante de la superficie)
color0 #{{colors.outline.default.hex_stripped}}
color8 #{{colors.outline.default.hex_stripped}}

# Rojo (Usamos 'Error' que es semánticamente correcto pero armonizado)
color1 #{{colors.error.default.hex_stripped}}
# Rojo Brillante (Usamos el container para una versión pastel/clara)
color9  {{colors.tertiary_fixed.default.hex}}

# Verde (Mapeado a Tertiary para mantener variaciones del tema)
color2 #{{colors.tertiary.default.hex_stripped}}
color10 #{{colors.tertiary_container.default.hex_stripped}}

# Amarillo (Mapeado a Secondary variant)
color3 #{{colors.secondary.default.hex_stripped}}
color11 #{{colors.secondary_container.default.hex_stripped}}

# Azul (El color predominante, Primary)
color4 #{{colors.primary.default.hex_stripped}}
color12 #{{colors.primary_container.default.hex_stripped}}

# Magenta (Reutilizamos Primary o Tertiary para consistencia monocromática)
color5 #{{colors.tertiary.default.hex_stripped}}
color13 #{{colors.tertiary_container.default.hex_stripped}}

# Cyan (Reutilizamos Secondary)
color6 #{{colors.secondary.default.hex_stripped}}
color14 #{{colors.secondary_container.default.hex_stripped}}

# Blanco (No usamos blanco puro #FFFFFF, sino el color de fondo para "ocultar" o contraste bajo)
# En un tema claro, el "Blanco" de la terminal suele ser el color más oscuro después del negro.
color7 #{{colors.on_surface_variant.default.hex_stripped}}
color15 #{{colors.on_surface.default.hex_stripped}}

# --- Ajustes Extra ---
url_color #{{colors.primary.default.hex_stripped}}
macos_titlebar_color background

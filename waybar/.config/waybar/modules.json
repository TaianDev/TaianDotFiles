{

"custom/notifications": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "swaync-client -t"
 }, 
 
"hyprland/workspaces": {
    "format" : "{icon}",
    "format-icons": {
      "active": "  ",
      "urgent": "󰵙",
      "default": " "
    },
    "on-click": "activate",
    "persistent-workspaces" : {
      "*" : 5
   }
  },
 
 "battery": {
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}% || ",
    "format-charging": " {capacity}% || ",
    "format-plugged": " {capacity}% || ",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
},

"custom/music":{
  "exec": "~/.config/waybar/scripts/music.sh",
  "format": "{}",
  "tooltip": false,
  "on-click": "kitty cava"
  },

"group/leftmodules": {
 "orientation": "horizontal",
 "modules": ["battery", "custom/music"]
},


"clock": {
 "format": "{:L%A %d/%m - %I:%M %p}",
 "format-alt": "{:L%I:%M:%S %p}",
 "tooltip" : false,
 "interval": 1,
 "smooth-scrolling-threshold": 0.01,
    "actions":  {
         "on-click-right": "mode",
           }
  },

"tray": {
    "icon-size": 15,
    "spacing": 10,
    "show-passive-items": true, 
    "reverse-direction": true
 },

"temperature": {
  "hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
  "format": "{temperatureC}°C_ ||",
  "tooltip-format": "CPU: {temperatureC}°C",
  "critical-threshold": 80
 },

"network": {
    "interval": 1,
    "format-wifi": "󰤨  Online ({signalStrength}%)",
    "format-ethernet": "󰈁 Ethernet",
    "format-disconnected": "󰤭 Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "Red: {essid} ({signalStrength}%)\nIP: {ipaddr}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-ethernet": "Conexión Cableada\nIP: {ipaddr}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "on-click": "/home/lostfromlight/.config/waybar/scripts/nmtui.sh"

},

"cpu": {
  "format": "{usage}%_  ||",
  "tooltip": true
 },

"memory": {
  "format": "{percentage}%_",
  "tooltip": true
 },
 
"group/system": {
 "orientation": "horizontal",
  "modules": ["temperature", "cpu","memory"]
},

"custom/power": {
  "format": "⏻",
  "tooltip": false,
  "on-click": "~/.config/wlogout/launcher.sh"
}

}

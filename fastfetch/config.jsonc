{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/skull.txt",
    "padding": {
      "top": 1,
      "right": 3,
      "left": 6,
    },
  },
 
  "display": {
    "separator": "> "
  },


  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[37m╔════════════════════════════════════════╗"
    },
    "break",
    {
      "type": "os",
      "key": "(󰣇) Distro ",
      "keyColor": "35"
    },
    {
      "type": "kernel",
      "key": "() Kernel ",
      "keyColor": "35"
    },
    {
      "type": "Packages",
      "format": "{}",
      "key": "(󰏗) Packages ",
      "keyColor": "32"
    },
    {
      "type": "shell",
      "key": "() Unix shell ",
      "keyColor": "32"
    },
    {
      "type": "terminal",
      "key": "() Terminal ",
      "keyColor": "33"
    },
    {
      "type": "wm",
      "format": "{} ({3})",
      "key": "() Window manager",
      "keyColor": "33"
    },
    
    {
      "type": "disk",
      "key": "(󱦟) OS Age ",
      "folders": "/",
      "keyColor": "34",
      "format": "{days} days"
    },

    {
      "type": "uptime",
      "key": "(󱫐) Uptime ",
      "keyColor": "34"
    },

    {
      "type": "disk",
      "format": "{1} / {2}", 
      "key": "() Disk ",
      "keyColor": "35",
      "path": "/"
    },
    
    {
      "type": "title",
      "key": "() User ",
      "keyColor": "35"
    },
  "break",
    {
      "type": "custom",
      "format": "\u001b[37m╚════════════════════════════════════════╝"
    },

    {
                "type": "custom",
            "format": "          \u001b[90m●  \u001b[37m●  \u001b[32m●  \u001b[33m●  \u001b[34m●  \u001b[35m●  \u001b[36m●  \u001b[37m● "
    },
    "break",
  ]
}


